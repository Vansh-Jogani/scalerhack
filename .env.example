# ARIA v1 — Environment Variables
# Copy this file to .env and fill in your keys.
#
# Get Anthropic API key at: https://console.anthropic.com/
# Get Mapbox token at: https://account.mapbox.com/access-tokens/

# Required for Agent 1 + Agent 2 (Claude API)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Required for frontend map display
MAPBOX_TOKEN=pk.your_mapbox_token_here
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
